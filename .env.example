# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase PostgreSQL Connection String (for running `npm run db:migrate`)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase Service Role Key (Optional: for direct Resend Magic Link generation)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend API Key for Email Delivery
RESEND_API_KEY=re_123456789...
RESEND_FROM_EMAIL="TDC e-Asset <onboarding@resend.dev>"

# Site URL (Use your Vercel domain in Production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
